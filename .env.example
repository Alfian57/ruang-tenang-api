# Environment
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ruang_tenang

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY_HOURS=24

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ruang-tenang.site
FRONTEND_URL=https://ruang-tenang.site

# AI Chat
GEMINI_API_KEY=your-gemini-api-key
CHAT_DAILY_MESSAGE_LIMIT=20

# Midtrans (Payments)
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Cache Configuration (optional - defaults shown)
CACHE_TTL_MINUTES=30
CACHE_LEVEL_CONFIG_TTL_MINUTES=60
CACHE_CONTENT_SYNC_INTERVAL_SECONDS=60

# Web Push (VAPID) - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT=mailto:admin@ruang-tenang.site
