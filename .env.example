# Ruang Tenang API — contoh environment lokal
# Salin ke .env dan ganti semua nilai secret/credential sebelum menjalankan server.

APP_ENV=development
PORT=8080
# APP_PORT=8080 # kompatibilitas lama; PORT adalah konfigurasi utama
APP_TIMEZONE=Asia/Jakarta

# Pilih salah satu: DATABASE_URL atau komponen DB_*.
# "postgres://username:password@host:port/database_name?sslmode=disable&TimeZone=Asia/Jakarta"
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ruang_tenang

JWT_SECRET=change-this-local-secret
JWT_EXPIRY_HOURS=24

# Pisahkan origin dengan koma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# AI Chat (feature yang memerlukan DeepSeek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_DAILY_MESSAGE_LIMIT=100
CHAT_QUOTA_RESET_INTERVAL=24h

# Model AI per area fitur.
AI_CHAT_MODEL=deepseek-flash
AI_MODERATION_MODEL=deepseek-flash
AI_JOURNAL_MODEL=deepseek-flash
AI_WELLNESS_MODEL=deepseek-flash

# Gunakan kredensial sandbox saat true dan kredensial production saat false.
DUITKU_SANDBOX=true
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

# Token perangkat Fonnte untuk mengirim kode reset kata sandi lewat WhatsApp.
FONNTE_TOKEN=

# Web Push (opsional; buat dengan npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@ruang-tenang.site

# Migration command; default lokal adalah ./migrations.
MIGRATIONS_PATH=./migrations

# Hanya dipakai entrypoint Docker.
RUN_MIGRATE=false
RUN_MIGRATE_FRESH=false
RUN_SEEDER=false

# Hanya untuk data demo lokal/staging.
SEED_ADMIN_PASSWORD=
